 // Cast To Date
 //===--------------------------------------------------------------------===//
+static bool DateCastTrailingIsValid(const char *buf, idx_t len, idx_t pos) {
+	if (pos >= len) {
+		return true;
+	}
+	if (buf[pos] == 'T' || buf[pos] == 't') {
+		pos++;
+	} else if (StringUtil::CharacterIsSpace(buf[pos])) {
+		while (pos < len && StringUtil::CharacterIsSpace(buf[pos])) {
+			pos++;
+		}
+	} else {
+		return false;
+	}
+	if (pos >= len) {
+		return true;
+	}
+	// remaining text must look like the start of a time portion
+	return StringUtil::CharacterIsDigit(buf[pos]);
+}
