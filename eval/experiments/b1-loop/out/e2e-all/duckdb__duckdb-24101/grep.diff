+// Matches "col IN (c1, c2, ...)" where all values are non-NULL constants of the column type.
+static bool GetBloomFilterInConstants(const Expression &expr, vector<Value> &constants) {
+	if (expr.GetExpressionClass() != ExpressionClass::BOUND_OPERATOR ||
+	    expr.GetExpressionType() != ExpressionType::COMPARE_IN) {
+		return false;
+	}
+	auto &op = expr.Cast<BoundOperatorExpression>();
+	if (op.children.size() < 2) {
+		return false;
+	}
+	auto &column = *op.children[0];
+	if (column.GetExpressionClass() != ExpressionClass::BOUND_REF ||
+	    column.Cast<BoundReferenceExpression>().Index() != 0) {
+		return false;
+	}
+	for (idx_t i = 1; i < op.children.size(); i++) {
+		auto &child = *op.children[i];
+		if (child.GetExpressionClass() != ExpressionClass::BOUND_CONSTANT) {
+			return false;
+		}
+		auto &value = child.Cast<BoundConstantExpression>().GetValue();
+		if (value.IsNull() || value.type() != column.GetReturnType()) {
+			return false;
+		}
+		constants.push_back(value);
+	}
+	return true;
+}
