+            if key < 0:
+                # pyarrow does not allow negative (or array) element indices,
+                # so compute positions in the flattened values manually.
+                lengths = pc.fill_null(pc.list_value_length(self._pa_array), 0)
+                starts = pc.subtract(pc.cumulative_sum(lengths), lengths)
+                rel = pc.add(lengths, key)
+                positions = pc.add(starts, rel)
+                positions = pc.if_else(pc.greater_equal(rel, 0), positions, None)
+                element = pc.take(pc.list_flatten(self._pa_array), positions)
+            else:
+                element = pc.list_element(self._pa_array, key)
