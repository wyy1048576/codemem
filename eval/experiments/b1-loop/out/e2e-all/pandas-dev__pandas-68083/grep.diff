     "high_memory: mark a test as requiring >5GB of memory",
+    "english_lc_time: run the test with an English LC_TIME (skip if unavailable)",
 ]
 
 
+_ENGLISH_LC_TIME_CANDIDATES = [
+    "C",
+    "en_US.UTF-8",
+    "en_US.utf8",
+    "en_US",
+    "English_United States.1252",
+]
+
+
+@pytest.fixture(autouse=True)
+def _english_lc_time(request):
+    """
+    For tests marked ``english_lc_time``, set LC_TIME to an English locale for
+    the duration of the test, restoring it afterwards. Skip if none is available.
+    """
+    if request.node.get_closest_marker("english_lc_time") is None:
+        yield
+        return
+
+    import locale
+
+    from pandas._config.localization import set_locale
+
+    if td.has_english_lc_time():
+        yield
+        return
+
+    for candidate in _ENGLISH_LC_TIME_CANDIDATES:
+        try:
+            cm = set_locale(candidate, lc_var=locale.LC_TIME)
+            cm.__enter__()
+        except (ValueError, locale.Error):
+            continue
+        if td.has_english_lc_time():
+            break
+        cm.__exit__(None, None, None)
+    else:
+        pytest.skip("Could not set an English LC_TIME")
+
+    try:
+        yield
+    finally:
+        cm.__exit__(None, None, None)
+
+
