diff --git a/pandas/util/_test_decorators.py b/pandas/util/_test_decorators.py
index 6c41bde..73c85d1 100644
--- a/pandas/util/_test_decorators.py
+++ b/pandas/util/_test_decorators.py
@@ -127,6 +127,44 @@ def _has_english_lc_time() -> bool:
     return stamp.strftime("%b|%B|%a|%A|%p") == "Jan|January|Wed|Wednesday|PM"
 
 
+def _english_lc_time_locale() -> str | None:
+    """
+    Name of an installed locale that gives English LC_TIME, or None.
+    """
+    import locale
+
+    from pandas._config.localization import can_set_locale
+
+    for loc in ("C", "en_US.UTF-8", "en_US"):
+        if can_set_locale(loc, locale.LC_TIME):
+            return loc
+    return None
+
+
+def _can_get_english_lc_time() -> bool:
+    return _has_english_lc_time() or _english_lc_time_locale() is not None
+
+
+@contextmanager
+def english_lc_time():
+    """
+    Ensure LC_TIME is English for the duration of the block, restoring it after.
+    """
+    import locale
+
+    from pandas._config.localization import set_locale
+
+    if _has_english_lc_time():
+        yield
+        return
+    loc = _english_lc_time_locale()
+    if loc is None:
+        yield
+        return
+    with set_locale(loc, locale.LC_TIME):
+        yield
+
+
 skip_if_not_english_lc_time = pytest.mark.skipif(
     not _has_english_lc_time(),
     reason="LC_TIME does not use English month names and AM/PM markers",
