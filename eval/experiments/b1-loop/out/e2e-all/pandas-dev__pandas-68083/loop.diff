+def english_lc_time():
+    """
+    Context manager making LC_TIME English for the duration of a test body.
+
+    LC_TIME is restored on exit. The test is skipped only if no English
+    LC_TIME can be obtained.
+    """
+    import contextlib
+    import locale
+
+    @contextlib.contextmanager
+    def _cm():
+        if _has_english_lc_time():
+            yield
+            return
+        previous = locale.setlocale(locale.LC_TIME)
+        for candidate in ("C", "en_US.UTF-8", "en_US"):
+            try:
+                locale.setlocale(locale.LC_TIME, candidate)
+            except locale.Error:
+                continue
+            if _has_english_lc_time():
+                break
+        else:
+            locale.setlocale(locale.LC_TIME, previous)
+            pytest.skip("cannot set an English LC_TIME")
+        try:
+            yield
+        finally:
+            locale.setlocale(locale.LC_TIME, previous)
+
+    return _cm()
 
