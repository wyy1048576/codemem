+    def __arrow_array__(self, type=None):
+        """
+        Convert the Series to a pyarrow Array (used by ``pyarrow.array``).
+
+        Avoids pyarrow calling ``Series.values``, which would raise a
+        deprecation warning for timezone-aware data, see GH#68426 and
+        apache/arrow#51302.
+        """
+        pa = import_optional_dependency("pyarrow", min_version="16.0.0")
+        values = self._values
+        if isinstance(values.dtype, DatetimeTZDtype):
+            # the underlying i8 data are UTC, matching pyarrow's representation
+            arr = pa.array(
+                values._ndarray,
+                type=pa.timestamp(values.unit, tz=str(values.tz)),
+                from_pandas=True,
+            )
+            return arr if type is None else arr.cast(type)
+        # Series.values is not deprecated for the remaining dtypes
+        with suppress_pyarrow_values_warning():
+            return pa.array(values, type=type, from_pandas=True)
