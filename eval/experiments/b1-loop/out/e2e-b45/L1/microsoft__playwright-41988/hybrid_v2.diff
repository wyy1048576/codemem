+// Whether the node's name text is still visible among its rendered descendants.
+function isNameRepresentedInChildren(node: aria.AriaNode): boolean {
+  const parts: string[] = [];
+  const collect = (n: aria.AriaNode) => {
+    for (const child of n.children) {
+      if (typeof child === 'string') {
+        parts.push(child);
+      } else {
+        if (child.name)
+          parts.push(child.name);
+        collect(child);
+      }
+    }
+  };
+  collect(node);
+  const text = normalizeWhiteSpace(parts.join(' '));
+  return !!node.name && text.includes(normalizeWhiteSpace(node.name));
+}
