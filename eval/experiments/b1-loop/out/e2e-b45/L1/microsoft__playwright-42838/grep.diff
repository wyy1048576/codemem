+  const NativeNow = NativeTemporal.Now;
+  const instant = () => new NativeTemporal.Instant(BigInt(Math.floor(clock.now())) * BigInt(1000000));
+  const zoned = (timeZone?: any) => instant().toZonedDateTimeISO(timeZone === undefined ? NativeNow.timeZoneId() : timeZone);
+  const ClockNow: any = {};
+  for (const key of Reflect.ownKeys(NativeNow)) {
+    const descriptor = Object.getOwnPropertyDescriptor(NativeNow, key)!;
+    Object.defineProperty(ClockNow, key, descriptor);
+  }
+  const define = (name: string, value: any) => Object.defineProperty(ClockNow, name, { value, writable: true, configurable: true, enumerable: false });
+  define('instant', () => instant());
+  define('zonedDateTimeISO', (timeZone?: any) => zoned(timeZone));
+  define('zonedDateTime', (calendar: any, timeZone?: any) => zoned(timeZone).withCalendar(calendar));
+  define('plainDateTimeISO', (timeZone?: any) => zoned(timeZone).toPlainDateTime());
+  define('plainDateTime', (calendar: any, timeZone?: any) => zoned(timeZone).toPlainDateTime().withCalendar(calendar));
+  define('plainDateISO', (timeZone?: any) => zoned(timeZone).toPlainDate());
+  define('plainDate', (calendar: any, timeZone?: any) => zoned(timeZone).toPlainDate().withCalendar(calendar));
+  define('plainTimeISO', (timeZone?: any) => zoned(timeZone).toPlainTime());
+
+  Object.defineProperty(ClockTemporal, 'Now', { value: ClockNow, writable: true, configurable: true, enumerable: false });
+  return ClockTemporal;
+}
