+/**
+ * Mirror Temporal on our fake implementation. Only Temporal.Now
+ * reads the clock, so it is the only part we replace.
+ */
+function createTemporal(clock: ClockController, NativeTemporal: any): any {
+  const ClockTemporal: any = {};
+  for (const key of Reflect.ownKeys(NativeTemporal)) {
+    const descriptor = Object.getOwnPropertyDescriptor(NativeTemporal, key)!;
+    Object.defineProperty(ClockTemporal, key, descriptor);
+  }
