+  const NativeTemporal = (globalObject as any).Temporal;
+  if (toFake.includes('Date') && NativeTemporal?.Now) {
+    const Now = NativeTemporal.Now;
+    const savedDescriptors: [string, PropertyDescriptor | undefined][] = [];
+    const zoned = (tz?: any) => NativeTemporal.Instant.fromEpochMilliseconds(Math.floor(clock.now())).toZonedDateTimeISO(tz === undefined ? Now.timeZoneId() : tz);
+    const replacements: Record<string, (tz?: any) => any> = {
+      instant: () => NativeTemporal.Instant.fromEpochMilliseconds(Math.floor(clock.now())),
+      zonedDateTimeISO: tz => zoned(tz),
+      plainDateTimeISO: tz => zoned(tz).toPlainDateTime(),
+      plainDateISO: tz => zoned(tz).toPlainDate(),
+      plainTimeISO: tz => zoned(tz).toPlainTime(),
+    };
+    for (const name of Object.keys(replacements)) {
+      if (typeof Now[name] !== 'function')
