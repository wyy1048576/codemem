+      savedDescriptors.push([name, Object.getOwnPropertyDescriptor(Now, name)]);
+      Object.defineProperty(Now, name, { value: replacements[name], writable: true, configurable: true, enumerable: false });
+    }
+    clock.disposables.push(() => {
+      for (const [name, descriptor] of savedDescriptors) {
+        if (descriptor)
+          Object.defineProperty(Now, name, descriptor);
+      }
+    });
