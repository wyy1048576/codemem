diff --git a/pandas/core/groupby/ops.py b/pandas/core/groupby/ops.py
index 94c092a..ef13880 100644
--- a/pandas/core/groupby/ops.py
+++ b/pandas/core/groupby/ops.py
@@ -978,6 +978,22 @@ class BaseGrouper:
         codes: list[npt.NDArray[np.intp]],
         names: list[Hashable],
     ) -> tuple[MultiIndex, npt.NDArray[np.intp]]:
+        new_levels = []
+        new_codes = []
+        for level, code in zip(levels, codes, strict=True):
+            if hasattr(level, "categories"):
+                # Level categories may have been reordered relative to the
+                # (recoded) grouping codes; align codes with category order.
+                lcodes = np.asarray(level.codes)
+                code = np.asarray(code)
+                mapped = np.where(code >= 0, lcodes.take(np.maximum(code, 0)), -1)
+                new_codes.append(mapped.astype(np.intp, copy=False))
+                new_levels.append(level.take(np.argsort(lcodes, kind="stable")))
+            else:
+                new_codes.append(code)
+                new_levels.append(level)
+        levels = new_levels
+        codes = new_codes
         shape = tuple(len(level) for level in levels)
         unob_ids = get_group_index(codes, shape, sort=True, xnull=True)
         unob_index = MultiIndex.from_product(levels, names=names)
