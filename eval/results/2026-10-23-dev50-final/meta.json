  "config_text": "# The two offline grep baselines (Decision 4).\n\n[[system]]\nname = \"grep\"\nadapter = \"grep\"\n\n[[system]]\nname = \"grep-fn\"\nadapter = \"grep_fn\"\n\n# The stronger grep baseline (2026-10-23): Python files only, rare keywords weigh more, noisy\n# keywords dropped, tests last.\n[[system]]\nname = \"grep-fn-plus\"\nadapter = \"grep_fn\"\ntypes = [\"py\"]\nweighting = \"idf\"\nclean_keywords = true\ntests_last = true\n\n# merged from 2026-10-23-dev50:\n# Baseline comparison: the two grep baselines and the current codemem (Week 1 hybrid baseline)\n# with signals added one at a time. The three codemem systems share one index (same index_key).\n# Needs: uv sync --extra codemem\n\n[[system]]\nname = \"grep\"\nadapter = \"grep\"\n\n[[system]]\nname = \"grep-fn\"\nadapter = \"grep_fn\"\n\n[[system]]\nname = \"cm-bm25\"\nadapter = \"codemem\"\nsignals = [\"bm25\"]\nconfig = { device = \"auto\" }\n\n[[system]]\nname = \"cm-bm25-code\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\"]\nconfig = { device = \"auto\" }\n\n[[system]]\nname = \"cm-bm25-code-usage\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\" }\n",
