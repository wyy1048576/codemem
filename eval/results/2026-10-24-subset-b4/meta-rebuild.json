  "config_text": "# codemem v2 (multi-language backend, docs/baseline-v2-diff.md). Every system here shares ONE index\n# (same index-time settings) and differs only at search time, so the variants cost one indexing run.\n# cm2-bm25 / cm2-bm25-code / cm2-bm25-code-usage mirror cm-* in baseline.toml (codemem v1).\n# Needs: uv sync --extra codemem\n\n[[system]]\nname = \"cm2-bm25\"\nadapter = \"codemem\"\nsignals = [\"bm25\"]\nconfig = { device = \"auto\" }\n\n[[system]]\nname = \"cm2-bm25-code\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\"]\nconfig = { device = \"auto\" }\n\n[[system]]\nname = \"cm2-bm25-code-usage\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\" }\n\n# Search-time variants of the full system.\n[[system]]\nname = \"cm2-full-fn\"  # functions and methods only (no class or block results)\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", kinds = [\"function\", \"method\"] }\n\n[[system]]\nname = \"cm2-full-tests-down\"  # test chunks keep half their fused score (like grep-fn-plus tests_last, softer)\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.5 }\n\n[[system]]\nname = \"cm2-full-no-tests\"  # test chunks never returned\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.0 }\n\n[[system]]\nname = \"cm2-full-v1-bm25\"  # v1 BM25 weights (name 10, signature 5, body 1; no path or doc field)\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", bm25 = { weights = [10, 5, 1] } }\n",
