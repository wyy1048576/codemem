  "config_text": "# Search-time weightings of codemem v2's full system (bm25 + code + usage). All share one index,\n# so with a warm vector cache this config costs no embedding at all. Used on dev to choose the\n# v2 defaults (docs/decisions-v2.md, D12): how much to push down tests, classes and blocks.\n\n[[system]]\nname = \"cm2-ref\"  # defaults: every kind, tests at full weight\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\" }\n\n[[system]]\nname = \"cm2-t05\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.5 }\n\n[[system]]\nname = \"cm2-t05-c05\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.5, kind_weights = { class = 0.5 } }\n\n[[system]]\nname = \"cm2-t05-c05-b05\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.5, kind_weights = { class = 0.5, block = 0.5 } }\n\n[[system]]\nname = \"cm2-t03-c03-b03\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.3, kind_weights = { class = 0.3, block = 0.3 } }\n\n[[system]]\nname = \"cm2-fn-t05\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", kinds = [\"function\", \"method\"], test_weight = 0.5 }\n\n[[system]]\nname = \"cm2-t0\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.0 }\n\n[[system]]\nname = \"cm2-t05-v1bm25\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.5, bm25 = { weights = [10, 5, 1] } }\n",
