  "config_text": "# codemem v3 (docs/architecture.md). Every system shares ONE index (same index-time settings) and\n# differs only at search time, so the variants cost one indexing run. Each system pins its weights\n# and its BM25 query rule, so a name keeps its meaning if the defaults change.\n# Needs: uv sync --extra codemem\n\n[[system]]\nname = \"cm3-bm25\"\nadapter = \"codemem\"\nsignals = [\"bm25\"]\nconfig = { device = \"auto\", test_weight = 1.0, kind_weights = {}, bm25 = { query_terms = 32, common_share = 0.0 } }\n\n[[system]]\nname = \"cm3-bm25-code\"\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\"]\nconfig = { device = \"auto\", test_weight = 1.0, kind_weights = {}, bm25 = { query_terms = 32, common_share = 0.0 } }\n\n[[system]]\nname = \"cm3-full\"  # the v3 default: neutral weights (D24); BM25 queries drop stopwords (D32)\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 1.0, kind_weights = {}, bm25 = { query_terms = 32, common_share = 0.0 } }\n\n[[system]]\nname = \"cm3-full-v2-weights\"  # v2's default weights: tests, classes and blocks keep half their score\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 0.5, kind_weights = { class = 0.5, block = 0.5 }, bm25 = { query_terms = 32, common_share = 0.0 } }\n\n[[system]]\nname = \"cm3-full-all-words\"  # BM25 queries keep every word, stopwords too, as v2 did\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 1.0, kind_weights = {}, bm25 = { query_terms = 0 } }\n\n[[system]]\nname = \"cm3-full-drop-common\"  # opt-in: a long query also drops words in over 5% of chunks (faster)\nadapter = \"codemem\"\nsignals = [\"bm25\", \"code\", \"usage\"]\nconfig = { device = \"auto\", test_weight = 1.0, kind_weights = {}, bm25 = { query_terms = 32, common_share = 0.05 } }\n",
  "split": "dev",
  "index_mode": "rebuild",
